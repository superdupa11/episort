# Copy this file to tv.secrets and fill in your credentials.
# Lines starting with # are ignored. Never commit tv.secrets to version control.

OPENSUBTITLES_API_KEY=your_api_key_here
OPENSUBTITLES_USERNAME=your_username_here
OPENSUBTITLES_PASSWORD=your_password_here

# Only needed with --ai-fallback
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# Optional: name shown in OpenSubtitles API requests
# OPENSUBTITLES_APP_NAME=episort v1.0
